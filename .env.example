# PostgreSQL local development database
DATABASE_URL=postgres://hallili:hallili@localhost:5432/hallili

# Required server-only secrets. Replace these placeholders locally; never commit real values.
# ENCRYPTION_KEY must decode to 32 bytes (base64 or hex).
ENCRYPTION_KEY=VALUES
BETTER_AUTH_SECRET=VALUES
BETTER_AUTH_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3000

# Microsoft sign-in is configured only when the approved tenant/account policy is known.
MICROSOFT_CLIENT_ID=VALUES
MICROSOFT_CLIENT_SECRET=VALUES
MICROSOFT_TENANT_ID=common

# External integrations are fail-closed by default.
LMS_INTEGRATION_ENABLED=false
LMS_REMOTE_DRAFTS_ENABLED=false
AI_PROVIDER=fake
AI_API_KEY=VALUES

# Microsoft sign-in remains disabled until tenant/account policy is approved.
MICROSOFT_SIGNIN_ENABLED=false
MICROSOFT_ALLOW_COMMON_TENANT=false
