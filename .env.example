# Qatar Education Monitor (.env)
# Copy this file to .env and fill in your local session values. NEVER commit .env.

# Session cookie header copied from your authenticated browser session.
# IMPORTANT: Never paste real values into logs or reports; all values are masked as "VALUES".
LMS_COOKIE="VALUES"

# Base URL of the Qatar Education portal.
LMS_BASE_URL="https://qeducation.edu.gov.qa"

# Default class / section ID used for assignments and lessons routes.
# Set this to your class ID, or pass --class-id / --url per command.
LMS_CLASS_ID="YOUR_CLASS_ID"

# Optional custom directory for generated reports (defaults to ./reports).
# REPORTS_DIR="reports"
