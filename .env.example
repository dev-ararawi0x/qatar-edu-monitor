# Qatar Education Monitor (.env)
# Copy this file to .env (repo root or apps/api) and fill in your local values.
# NEVER commit .env. All sensitive values are masked as "VALUES" in outputs.

# ── CLI surface (@qatar-edu/cli) ──────────────────────────────────────────

# Session cookie header copied from your authenticated browser session.
LMS_COOKIE="VALUES"

# Base URL of your LMS portal.
LMS_BASE_URL="https://qeducation.edu.gov.qa"

# Default class / section ID used for assignments and lessons routes.
LMS_CLASS_ID="YOUR_CLASS_ID"

# Optional custom directory for generated reports (defaults to ./reports).
# REPORTS_DIR="reports"

# ── API surface (@qatar-edu/api) ──────────────────────────────────────────

# PostgreSQL connection string
DATABASE_URL="postgres://postgres:VALUES@localhost:5432/qatar_edu_monitor"

# better-auth
BETTER_AUTH_SECRET="VALUES"            # >= 16 chars random secret
BETTER_AUTH_URL="http://localhost:3001"
WEB_ORIGIN="http://localhost:5173"     # Vite dev origin (CORS + trusted origin)

# Email/password auth is enabled by default (register + login forms).
# Microsoft Entra ID OAuth is OPTIONAL — the provider only activates when
# both credentials below are set.
MICROSOFT_CLIENT_ID="VALUES"
MICROSOFT_CLIENT_SECRET="VALUES"
MICROSOFT_TENANT_ID="common"           # or your tenant GUID / "organizations"

# AES-256-GCM encryption key for LMS cookies & user LLM keys (64 hex chars)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_KEY="VALUES"

# Default LLM provider used when a user has no override
LLM_PROVIDER="gemini"                  # gemini | openai | anthropic | mock
LLM_MODEL=""
LLM_API_KEY="VALUES"
LLM_BASE_URL=""
LLM_FALLBACK_MODELS=""

# API server
PORT=3001

# Set to "false" to run the background solve worker as a separate process
ENABLE_EMBEDDED_WORKER="true"
