{
  "name": "qatar-edu-monitor",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:core": "pnpm --filter @qatar-edu/core test",
    "test:cli": "pnpm --filter @qatar-edu/cli test",
    "test:api": "pnpm --filter @qatar-edu/api test",
    "test:web": "pnpm --filter @qatar-edu/web test",
    "cli": "pnpm --filter @qatar-edu/cli cli",
    "monitor": "pnpm --filter @qatar-edu/cli monitor",
    "assignments:list": "pnpm --filter @qatar-edu/cli assignments:list",
    "assignments:due": "pnpm --filter @qatar-edu/cli assignments:due",
    "lessons:list": "pnpm --filter @qatar-edu/cli lessons:list",
    "quiz:inspect": "pnpm --filter @qatar-edu/cli quiz:inspect",
    "quiz:scan": "pnpm --filter @qatar-edu/cli quiz:scan",
    "quiz:draft": "pnpm --filter @qatar-edu/cli quiz:draft",
    "quiz:solve": "pnpm --filter @qatar-edu/cli quiz:solve",
    "dev": "bash scripts/dev.sh",
    "start": "bash scripts/start.sh",
    "setup": "bash scripts/ensure-api-env.sh && bash scripts/db-docker.sh up",
    "api:dev": "pnpm --filter @qatar-edu/api dev",
    "api:start": "pnpm --filter @qatar-edu/api start",
    "api:worker": "pnpm --filter @qatar-edu/api worker",
    "db:generate": "pnpm --filter @qatar-edu/api db:generate",
    "db:migrate": "pnpm --filter @qatar-edu/api db:migrate",
    "db:up": "bash scripts/db-docker.sh up",
    "db:down": "bash scripts/db-docker.sh down",
    "web:dev": "pnpm --filter @qatar-edu/web dev",
    "build": "pnpm -r build",
    "clean": "pnpm -r exec rm -rf dist"
  },
  "packageManager": "pnpm@10.12.1",
  "devDependencies": {
    "concurrently": "^10.0.7"
  }
}
