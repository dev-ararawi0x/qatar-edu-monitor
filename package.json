{
  "name": "qatar-edu-monitor",
  "version": "2.0.0",
  "description": "Modular Qatar Education LMS CLI monitor with sanitized logging and Arabic Markdown reports",
  "type": "module",
  "main": "dist/src/cli.js",
  "bin": {
    "qedu": "dist/src/cli.js"
  },
  "scripts": {
    "cli": "tsx src/cli.ts",
    "monitor": "tsx src/cli.ts monitor",
    "assignments:list": "tsx src/cli.ts assignments list",
    "assignments:due": "tsx src/cli.ts assignments due",
    "lessons:list": "tsx src/cli.ts lessons list",
    "quiz:inspect": "tsx src/cli.ts quiz inspect",
    "quiz:scan": "tsx src/cli.ts quiz scan",
    "quiz:draft": "tsx src/cli.ts quiz draft",
    "quiz:solve": "tsx src/cli.ts quiz solve",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "build": "tsc"
  },
  "keywords": [
    "lms",
    "qatar-education",
    "cheerio",
    "typescript",
    "cli"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "cheerio": "^1.2.0",
    "dotenv": "^18.0.10"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
